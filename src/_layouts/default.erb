<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <%= render "head", metadata: site.metadata, title: data.title %>
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink antialiased">
    <a href="#contenu" class="sr-only z-30 rounded bg-white px-4 py-2 font-semibold text-brand focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Aller au contenu</a>
    <%= render Shared::Navbar.new(metadata: site.metadata, resource: resource) %>

    <main id="contenu" class="flex-1">
      <%= yield %>
    </main>

    <%= render "footer", metadata: site.metadata %>
  </body>
</html>
