  "sport" => "Taekwondo",
  "address" => {
    "@type" => "PostalAddress",
    "streetAddress" => "3 rue de Bourgogne",
    "postalCode" => "41600",
    "addressLocality" => "Lamotte-Beuvron",
    "addressCountry" => "FR"
  }
